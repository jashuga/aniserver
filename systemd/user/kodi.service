[Unit]
Description=Kodi (HTPC front end), restarted automatically if it crashes
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# PulseAudio output mode (via pipewire-pulse): Kodi 21's native PipeWire output crashed while listing audio devices
Environment=KODI_AE_SINK=PULSE
# give the desktop a moment after login so Kodi opens full screen in front
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/kodi
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
